# CareBridge - Example environment configuration
# Copy the required values to your local environment.
# Never commit real passwords or access tokens.

# PostgreSQL
QUARKUS_DATASOURCE_USERNAME=carebridge_user
QUARKUS_DATASOURCE_PASSWORD=replace_with_your_password
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/carebridge_db

# Keycloak
# The current development configuration expects:
# http://localhost:8180/realms/carebridge
#
# Realm: carebridge
# Backend client: carebridge-api
# Frontend client: carebridge-web